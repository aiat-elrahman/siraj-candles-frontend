/* Siraj Candles — landing page template. Uses the brand tokens only. */
.lp-root {
    --lp-dark: #1E1023; --lp-rose: #BE185D; --lp-pink: #F472B6; --lp-mid: #6B4A6E;
    --lp-light: #D8B4D8; --lp-cream: #FCE7F3; --lp-pale: #FFF0F6;
    font-family: 'Montserrat', sans-serif; color: var(--lp-dark); background: #fff;
}
.lp-wrap { max-width: 1100px; margin: 0 auto; padding: 0 16px; }
.lp-wrap-narrow { max-width: 760px; }
.lp-loading, .lp-empty { text-align: center; padding: 60px 16px; color: var(--lp-mid); }

.lp-h2 { font-family: 'Cormorant Garamond', serif; font-size: 2.2rem; font-weight: 700; text-align: center; margin: 0 0 28px; color: var(--lp-dark); }

/* Hero */
.lp-hero { background: var(--lp-dark) center/cover no-repeat; color: #fff; text-align: center; padding: 72px 16px 64px; }
.lp-hero-inner { max-width: 760px; margin: 0 auto; }
.lp-eyebrow { text-transform: uppercase; letter-spacing: .22em; font-size: .78rem; color: var(--lp-pink); margin: 0 0 14px; font-weight: 600; }
.lp-headline { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1.1; margin: 0 0 16px; font-weight: 700; color: #fff; }
.lp-sub { font-size: 1.05rem; line-height: 1.6; margin: 0 0 20px; color: var(--lp-cream); }
.lp-offer { display: inline-block; background: var(--lp-cream); color: var(--lp-rose); font-weight: 600; font-size: .85rem; padding: 8px 16px; border-radius: 999px; margin: 0 0 24px; }
.lp-cta { display: inline-block; background: var(--lp-rose); color: #fff; text-decoration: none; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; font-size: .9rem; padding: 16px 38px; border-radius: 4px; transition: background .2s; }
.lp-cta:hover { background: var(--lp-pink); }

/* Benefits */
.lp-benefits { background: var(--lp-pale); padding: 40px 0; }
.lp-benefits .lp-wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; }
.lp-benefit { text-align: center; padding: 8px; }
.lp-benefit i { font-size: 1.6rem; color: var(--lp-rose); margin-bottom: 10px; }
.lp-benefit h3 { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; margin: 6px 0; }
.lp-benefit p { font-size: .88rem; color: var(--lp-mid); margin: 0; line-height: 1.5; }

/* Products */
.lp-products { padding: 56px 0; }
.lp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px; }
.lp-card { background: #fff; border: 1px solid var(--lp-light); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; }
.lp-card-img { display: block; aspect-ratio: 1 / 1; background: var(--lp-cream); }
.lp-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.lp-card-body { padding: 16px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
.lp-card-title { font-family: 'Cormorant Garamond', serif; font-size: 1.35rem; margin: 0; line-height: 1.2; }
.lp-card-title a { color: var(--lp-dark); text-decoration: none; }
.lp-price { font-weight: 700; color: var(--lp-rose); }
.lp-price-old { text-decoration: line-through; color: var(--lp-mid); font-size: .9rem; }
.lp-card-actions { margin-top: auto; display: flex; flex-direction: column; gap: 8px; }
.lp-variant { width: 100%; padding: 10px; border: 1px solid var(--lp-light); border-radius: 4px; font-family: inherit; font-size: .88rem; color: var(--lp-dark); background: #fff; }
.lp-btn { display: block; width: 100%; box-sizing: border-box; text-align: center; text-decoration: none; background: var(--lp-rose); color: #fff; border: 0; border-radius: 4px; padding: 13px 12px; font-family: inherit; font-weight: 600; font-size: .85rem; letter-spacing: .06em; text-transform: uppercase; cursor: pointer; transition: background .2s; }
.lp-btn:hover { background: var(--lp-pink); }
.lp-btn-disabled, .lp-btn-disabled:hover { background: var(--lp-light); color: var(--lp-mid); cursor: not-allowed; }

/* How ordering works */
.lp-how { background: var(--lp-cream); padding: 56px 0; }
.lp-steps { list-style: none; margin: 0 auto; padding: 0; max-width: 760px; display: grid; gap: 18px; }
.lp-steps li { display: flex; gap: 16px; align-items: flex-start; background: #fff; border-radius: 8px; padding: 18px; }
.lp-step-num { flex: 0 0 38px; height: 38px; border-radius: 50%; background: var(--lp-rose); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; }
.lp-steps h3 { font-family: 'Cormorant Garamond', serif; font-size: 1.25rem; margin: 0 0 4px; }
.lp-steps p { margin: 0; font-size: .9rem; line-height: 1.55; color: var(--lp-mid); }

/* Reviews */
.lp-reviews { padding: 56px 0; }
.lp-review-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
.lp-review { margin: 0; background: var(--lp-pale); border-radius: 8px; padding: 20px; }
.lp-review p { margin: 10px 0; font-size: .92rem; line-height: 1.6; }
.lp-review footer { font-size: .8rem; color: var(--lp-mid); font-weight: 600; }
.lp-stars { color: var(--lp-rose); font-size: .85rem; letter-spacing: 2px; }

/* FAQ */
.lp-faq { background: var(--lp-pale); padding: 56px 0; }
.lp-faq-item { background: #fff; border: 1px solid var(--lp-light); border-radius: 6px; margin-bottom: 10px; padding: 14px 18px; }
.lp-faq-item summary { cursor: pointer; font-weight: 600; color: var(--lp-dark); }
.lp-faq-item p { margin: 10px 0 0; font-size: .92rem; line-height: 1.6; color: var(--lp-mid); }

.lp-notfound { text-align: center; padding: 100px 16px; }
.lp-notfound .lp-headline { color: var(--lp-dark); }
.lp-notfound p { color: var(--lp-mid); margin-bottom: 24px; }

/* Sticky mobile order bar */
.lp-sticky { display: none; }
@media (max-width: 768px) {
    .lp-sticky { display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 900; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: #fff; border-top: 1px solid var(--lp-light, #D8B4D8); box-shadow: 0 -4px 14px rgba(30,16,35,.12); }
    .lp-sticky[hidden] { display: none; }
    .lp-sticky-shop { flex: 1; text-align: center; background: #BE185D; color: #fff; text-decoration: none; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; font-size: .85rem; padding: 14px; border-radius: 4px; }
    .lp-sticky-cart { display: none; align-items: center; gap: 6px; background: #1E1023; color: #fff; text-decoration: none; font-weight: 600; font-size: .85rem; padding: 14px 18px; border-radius: 4px; }
    .lp-sticky.has-items .lp-sticky-cart { display: flex; }
    .lp-sticky.has-items .lp-sticky-shop { background: #F472B6; }
    body[data-page="landing"] { padding-bottom: 72px; }
    .lp-hero { padding: 48px 16px 44px; }
    .lp-h2 { font-size: 1.8rem; }
}